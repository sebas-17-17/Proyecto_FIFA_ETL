from dash import Dash, html, dcc, Input, Output
import dash_bootstrap_components as dbc
import plotly.express as px
import pandas as pd
from sqlalchemy import create_engine

# =====================================================
# CONEXIÓN MYSQL
# =====================================================

engine = create_engine(
    "mysql+pymysql://fifa_user:Fifa2026!@localhost:3306/db_fifa_parametros"
)

# =====================================================
# CARGAR DATOS
# =====================================================

ranking = pd.read_sql(
    "SELECT * FROM kpi_ranking",
    engine
)

ofensiva = pd.read_sql(
    "SELECT * FROM kpi_ofensiva",
    engine
)

evolucion = pd.read_sql(
    "SELECT * FROM kpi_evolucion",
    engine
)

rendimiento = pd.read_sql(
    "SELECT * FROM kpi_rendimiento",
    engine
)

equipos = sorted(
    ranking["team"].dropna().unique()
)

# =====================================================
# DASH
# =====================================================

app = Dash(
    __name__,
    external_stylesheets=[
        dbc.themes.CYBORG
    ]
)

app.title = "Proyecto FIFA BI"

# =====================================================
# ESTILOS
# =====================================================

CARD_STYLE = {

    "backgroundColor":"#1b263b",

    "borderRadius":"18px",

    "padding":"12px",

    "boxShadow":"0px 0px 18px rgba(0,0,0,0.35)"

}

HEADER_STYLE={

    "textAlign":"center",

    "fontSize":"42px",

    "fontWeight":"bold",

    "color":"white",

    "marginBottom":"10px"

}

SUB_STYLE={

    "textAlign":"center",

    "color":"#A9CCE3",

    "marginBottom":"25px"

}

# =====================================================
# LAYOUT
# =====================================================

app.layout=dbc.Container(

fluid=True,

style={

"background":"linear-gradient(180deg,#0B132B,#1C2541)",

"minHeight":"100vh",

"padding":"30px"

},

children=[

html.H1(

"⚽ FIFA WORLD CUP ANALYTICS",

style=HEADER_STYLE

),

html.P(

"Dashboard de Inteligencia de Negocios",

style=SUB_STYLE

),

dbc.Row(

[

dbc.Col(

dcc.Dropdown(

id="equipo",

options=[

{

"label":i,

"value":i

}

for i in equipos

],

value=equipos[0],

clearable=False,

style={

"color":"black",

"fontWeight":"bold"

}

),

width=6

)

],

justify="center"

),

html.Br(),

dbc.Row(

[

dbc.Col(

dbc.Card(

dcc.Graph(

id="grafico_ranking"

),

style=CARD_STYLE

),

md=6

),

dbc.Col(

dbc.Card(

dcc.Graph(

id="grafico_ofensiva"

),

style=CARD_STYLE

),

md=6

)

]

),

html.Br(),

dbc.Row(

[

dbc.Col(

dbc.Card(

dcc.Graph(

id="grafico_rendimiento"

),

style=CARD_STYLE

),

md=6

),

dbc.Col(

dbc.Card(

dcc.Graph(

id="grafico_evolucion"

),

style=CARD_STYLE

),

md=6

)

]

)

]

)

# =====================================================
# CALLBACK
# =====================================================

@app.callback(

    Output("grafico_ranking", "figure"),
    Output("grafico_ofensiva", "figure"),
    Output("grafico_rendimiento", "figure"),
    Output("grafico_evolucion", "figure"),

    Input("equipo", "value")

)

def actualizar(equipo):

    r = ranking[ranking["team"] == equipo]
    o = ofensiva[ofensiva["team"] == equipo]
    p = rendimiento[rendimiento["team"] == equipo]

    # =====================================================
    # KPI 1
    # =====================================================

    fig1 = px.bar(

        r,

        x="team",

        y="win_percentage",

        text="win_percentage",

        color="win_percentage",

        color_continuous_scale="Turbo",

        title="🏆 Porcentaje de Victorias"

    )

    fig1.update_traces(

        texttemplate="%{text:.2f}%",

        textposition="outside",

        marker_line_width=2,

        marker_line_color="white"

    )

    fig1.update_layout(

        title_x=0.5,

        title_font_size=22,

        paper_bgcolor="#1b263b",

        plot_bgcolor="#1b263b",

        font_color="white",

        coloraxis_showscale=False,

        xaxis_title="",

        yaxis_title="% Victorias"

    )

    # =====================================================
    # KPI 2
    # =====================================================

    fig2 = px.bar(

        o,

        x="team",

        y="avg_goals",

        text="avg_goals",

        color="avg_goals",

        color_continuous_scale="Viridis",

        title="⚽ Promedio de Goles"

    )

    fig2.update_traces(

        texttemplate="%{text:.2f}",

        textposition="outside",

        marker_line_width=2,

        marker_line_color="white"

    )

    fig2.update_layout(

        title_x=0.5,

        title_font_size=22,

        paper_bgcolor="#1b263b",

        plot_bgcolor="#1b263b",

        font_color="white",

        coloraxis_showscale=False,

        xaxis_title="",

        yaxis_title="Goles"

    )
    # =====================================================
    # KPI 3
    # =====================================================

    fig3 = px.bar(

        p,

        x="team",

        y="performance_index",

        text="performance_index",

        color="performance_index",

        color_continuous_scale="Plasma",

        title="📈 Índice de Rendimiento"

    )

    fig3.update_traces(

        texttemplate="%{text:.3f}",

        textposition="outside",

        marker_line_width=2,

        marker_line_color="white"

    )

    fig3.update_layout(

        title_x=0.5,

        title_font_size=22,

        paper_bgcolor="#1b263b",

        plot_bgcolor="#1b263b",

        font_color="white",

        coloraxis_showscale=False,

        xaxis_title="",

        yaxis_title="Índice"

    )

    # =====================================================
    # KPI 4
    # =====================================================

    fig4 = px.area(

        evolucion,

        x="version",

        y="avg_goals",

        markers=True,

        title="🌍 Evolución Histórica de Goles",

        color_discrete_sequence=["#00E5FF"]

    )

    fig4.update_traces(

        mode="lines+markers",

        line=dict(width=5),

        marker=dict(

            size=10,

            color="#FFD54F",

            line=dict(

                color="white",

                width=2

            )

        )

    )

    fig4.update_layout(

        title_x=0.5,

        title_font_size=22,

        paper_bgcolor="#1b263b",

        plot_bgcolor="#1b263b",

        font_color="white",

        xaxis_title="Versión FIFA",

        yaxis_title="Promedio de Goles"

    )

    fig4.update_xaxes(

        showgrid=False

    )

    fig4.update_yaxes(

        gridcolor="rgba(255,255,255,0.12)"

    )
    # =====================================================
    # ESTILO GENERAL FIGURA 1
    # =====================================================

    fig1.update_xaxes(

        showgrid=False,
        zeroline=False

    )

    fig1.update_yaxes(

        gridcolor="rgba(255,255,255,0.10)"

    )

    fig1.update_layout(

        transition_duration=700,

        hoverlabel=dict(

            bgcolor="#0d1b2a",
            font_size=15,
            font_color="white"

        )

    )

    # =====================================================
    # ESTILO GENERAL FIGURA 2
    # =====================================================

    fig2.update_xaxes(

        showgrid=False,
        zeroline=False

    )

    fig2.update_yaxes(

        gridcolor="rgba(255,255,255,0.10)"

    )

    fig2.update_layout(

        transition_duration=700,

        hoverlabel=dict(

            bgcolor="#0d1b2a",
            font_size=15,
            font_color="white"

        )

    )

    # =====================================================
    # ESTILO GENERAL FIGURA 3
    # =====================================================

    fig3.update_xaxes(

        showgrid=False,
        zeroline=False

    )

    fig3.update_yaxes(

        gridcolor="rgba(255,255,255,0.10)"

    )

    fig3.update_layout(

        transition_duration=700,

        hoverlabel=dict(

            bgcolor="#0d1b2a",
            font_size=15,
            font_color="white"

        )

    )

    # =====================================================
    # ESTILO GENERAL FIGURA 4
    # =====================================================

    fig4.update_layout(

        transition_duration=700,

        hoverlabel=dict(

            bgcolor="#0d1b2a",
            font_size=15,
            font_color="white"

        )

    )

    fig4.update_traces(

        fill="tozeroy"

    )
